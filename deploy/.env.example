# Environment variables for HyderabadUrbanReality production deployment
# Copy this file to /opt/hyderabad-urban-reality/.env on the server
# chmod 600 /opt/hyderabad-urban-reality/.env
# chown www-data:www-data /opt/hyderabad-urban-reality/.env
# DO NOT commit the real .env file — only this example

# ── Flask ─────────────────────────────────────────────────────
FLASK_SECRET_KEY=replace-with-long-random-string
FLASK_DEBUG=0
ALLOWED_ORIGINS=http://YOUR_DOMAIN_OR_IP

# ── .NET ─────────────────────────────────────────────────────
# These override appsettings.json values when ASPNETCORE_ENVIRONMENT=Production
# Use double underscores for nested keys: Section__Key
AppSettings__JwtSecret=replace-with-long-random-jwt-secret
AppSettings__AdminPasswordHash=replace-with-bcrypt-hash
AppSettings__AllowedOrigins=http://YOUR_DOMAIN_OR_IP

# ── Google Analytics & Tag Manager ────────────────────────────
# Google Tag Manager Container ID
GTM_ID=GTM-TGZ9ZL9K
# Google Analytics 4 Measurement ID
GA4_MEASUREMENT_ID=G-9WEPYXSXVC
