{
  "name": "hyderabad-urban-realty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node --no-deprecation ./node_modules/@angular/cli/bin/ng serve --open",
    "serve": "ng serve",
    "serve:quiet": "node --no-deprecation ./node_modules/@angular/cli/bin/ng serve --open",
    "build": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --no-progress",
    "build:prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --no-progress",
    "build:stats": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production --stats-json --no-progress",
    "analyze": "webpack-bundle-analyzer dist/hyderabad-urban-realty/stats.json",
    "server:prod": "node server.js",
    "start:prod": "npm run build:prod && npm run server:prod",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.0",
    "@angular/cli": "^21.2.22",
    "@angular/common": "^21.2.22",
    "@angular/compiler": "^21.2.22",
    "@angular/compiler-cli": "^21.2.22",
    "@angular/core": "^21.2.22",
    "@angular/forms": "^21.2.22",
    "@angular/platform-browser": "^21.2.22",
    "@angular/platform-browser-dynamic": "^21.2.22",
    "@angular/router": "^21.2.22",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "express": "^4.22.1",
    "helmet": "^7.2.0",
    "http-proxy-middleware": "^2.0.6",
    "mapbox-gl": "^2.13.0",
    "maplibre-gl": "^3.6.2",
    "ng2-charts": "^5.0.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.5.0",
    "typescript": "~5.9.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@types/mapbox-gl": "^2.4.0"
  }
}
